# LLM — either provider works, same interface (agent/llm.py). The challenge
# allows any LLM. LLM_PROVIDER picks explicitly; if left blank it auto-picks
# gemini when a Gemini key is set, else anthropic.
#   gemini    - GEMINI_API_KEY, free tier, no credit card (get one at
#               https://aistudio.google.com/apikey)
#   anthropic - ANTHROPIC_API_KEY, requires billing/credits added first
LLM_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Graph backend:
#   tigergraph      - direct pyTigerGraph connection to real Savanna/CE
#   tigergraph_mcp  - same graph, routed through the TigerGraph MCP server
#                      (satisfies the challenge's "use TigerGraph MCP" requirement
#                      literally; see graph/tigergraph_mcp_backend.py)
#   local           - offline in-memory fallback built from the CSVs (dev/demo
#                      only when *.tgcloud.io isn't reachable from this machine)
GRAPH_BACKEND=tigergraph

# TigerGraph Savanna / Community Edition connection
TG_HOST=https://YOUR-WORKSPACE.i.tgcloud.io
TG_GRAPH_NAME=HHGOA_Fraud
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=
# For Savanna, generate a secret/token in the workspace UI (Admin Portal ->
# Users -> API Tokens) rather than using the account password in code.

# TigerGraph MCP (pip install tigergraph-mcp; https://pypi.org/project/tigergraph-mcp/)
# only used when GRAPH_BACKEND=tigergraph_mcp.
#   TG_MCP_URL unset -> stdio: this process spawns `tigergraph-mcp` itself,
#                       using the TG_HOST/TG_USERNAME/... vars above.
#   TG_MCP_URL set   -> streamable-http: connects to an already-running
#                       `tigergraph-mcp --transport streamable-http` server at
#                       that URL instead (credentials travel as headers).
TG_MCP_URL=
TG_MCP_PROFILE=
TG_API_TOKEN=

# Paths
DATA_DIR=./data
CASES_OUTPUT_DIR=./cases
